{
  "name": "ozastra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm generate:i18n-output && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "roadmap": "node scripts/update-roadmap.mjs",
    "roadmap:validate": "node scripts/update-roadmap.mjs validate",
    "locale:add": "node scripts/add-locale.mjs",
    "generate:i18n-output": "node scripts/generate-i18n-output.mjs",
    "check:i18n-output": "node scripts/generate-i18n-output.mjs --check",
    "i18n:extract": "lingui extract --clean --config lingui.all.config.ts",
    "i18n:compile": "lingui compile --strict",
    "i18n:validate": "pnpm check:i18n-output && pnpm i18n:compile"
  },
  "dependencies": {
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "@mdx-js/react": "3.1.1",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-start": "1.168.38",
    "gsap": "3.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@lingui/cli": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@lingui/vite-plugin": "6.6.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.24",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "nitro": "npm:nitro-nightly@3.0.1-20260731-205209-52abde8a",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
