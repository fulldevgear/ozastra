# Public origins. VITE_SITE_URL is embedded during the image build.
VITE_SITE_URL=https://ozastra.com
OZASTRA_DOMAIN=ozastra.com

# Contact delivery. Install the real values in the production secret store.
CONTACT_RECIPIENT=hello@ozastra.com
CONTACT_SENDER=Ozastra Website <website@ozastra.com>
CONTACT_PROVIDER_API_KEY=

# Anti-abuse limits.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
