# Public site URL used for canonical links and social metadata.
VITE_SITE_URL=http://localhost:3000

# Contact delivery. Keep real values in .env.local or the production secret store.
# Provider: Resend Email API (server-side only).
CONTACT_RECIPIENT=hello@ozastra.com
CONTACT_SENDER=Ozastra Website <website@ozastra.com>
CONTACT_PROVIDER_API_KEY=

# Optional anti-abuse configuration.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
